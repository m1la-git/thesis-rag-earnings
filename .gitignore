# IDE
.idea/
*.iml

# Python
.venv/
venv/
env/
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/

# Secrets
.env
.env.*
secret_keys.txt

# Local-only probe of the LM Studio backend (reads LMSTUDIO_API_KEY)
scripts/dev_local_llm_test.py

# Data: the corpus is downloaded by src/ingest.py; only the freeze record is tracked.
# (`data/*`, not `data/`, so the negation below can re-include a file.)
data/*
!data/corpus_manifest.json
corpus/
chroma_db/
faiss_index/

# Global exclusions, re-included where the files are results
*.jsonl
*.csv
*.pdf
!results/**/*.jsonl
!results/**/*.json
!results/**/*.csv
!benchmark/questions.jsonl

# Per-chunk truncation bookkeeping; regenerated by src/run_experiment.py
results/index_text/

# analysis/: scripts and their output documents are tracked;
# benchmark-authoring working material is not.
analysis/*
!analysis/*.py
!analysis/claims_map.md
!analysis/expectations/
!analysis/expectations/*.json
!analysis/stage1/
!analysis/stage1/*.md
!analysis/stage1/*.csv
!analysis/qwen3.8-27b_q4_k_xl/
!analysis/qwen3.8-27b_q4_k_xl/*.md
!analysis/qwen3.8-27b_q4_k_xl/*.csv
!analysis/qwen3.8-27b_q8_k_xl/
!analysis/qwen3.8-27b_q8_k_xl/*.md
!analysis/qwen3.8-27b_q8_k_xl/*.csv
!analysis/qwen3.8-flash-next/
!analysis/qwen3.8-flash-next/*.md
!analysis/qwen3.8-flash-next/*.csv

# Thesis: source, template assets and generated figures are tracked; build output is not.
!thesis/**/*.pdf
thesis/generated/*.png
thesis/build/
thesis/**/*.aux
thesis/**/*.bbl
thesis/**/*.bcf
thesis/**/*.blg
thesis/**/*.fdb_latexmk
thesis/**/*.fls
thesis/**/*.lof
thesis/**/*.log
thesis/**/*.lot
thesis/**/*.out
thesis/**/*.run.xml
thesis/**/*.synctex.gz
thesis/**/*.toc

# Submission paperwork, handed in separately
thesis/additional-documents/
